# Auth (simple username/password)
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$2b$12$... # bcrypt hash of password
NEXTAUTH_SECRET=your-random-secret-key
NEXTAUTH_URL=http://localhost:3000  # or https://your-railway-url.up.railway.app

# Google Cloud Credentials
# For local development, use the file path:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# For Railway/cloud deployment, use base64-encoded JSON:
# Run: cat credentials/service-account.json | base64
# GOOGLE_CREDENTIALS_JSON=<base64-encoded-service-account-json>

# Multi-site configuration
SITES=sextflirt,crushfling,fanscritic

SITE_sextflirt_GA4=123456789
SITE_sextflirt_GSC=sc-domain:sextflirt.com

SITE_crushfling_GA4=987654321
SITE_crushfling_GSC=sc-domain:crushfling.com

SITE_fanscritic_GA4=111222333
SITE_fanscritic_GSC=sc-domain:fanscritic.com

# Optional: Cache TTL in minutes (default: 15)
# CACHE_TTL_MINUTES=15
