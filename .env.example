# Google Cloud Credentials
# For local development, use the file path:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# For Railway/cloud deployment, use base64-encoded JSON:
# GOOGLE_CREDENTIALS_JSON=<base64-encoded-service-account-json>

# Multi-site configuration
SITES=site1,site2,site3

# Site 1
SITE_site1_GA4=123456789
SITE_site1_GSC=sc-domain:site1.com

# Site 2
SITE_site2_GA4=987654321
SITE_site2_GSC=sc-domain:site2.com

# Site 3
SITE_site3_GA4=111222333
SITE_site3_GSC=sc-domain:site3.com

# Optional: Cache TTL in minutes (default: 15)
# CACHE_TTL_MINUTES=15
